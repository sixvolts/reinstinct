From 058d978482b8fb5d9f417592cd5ecc4c72f52619 Mon Sep 17 00:00:00 2001
From: sixvolts <rigel@sixvolts.org>
Date: Sat, 3 Oct 2026 04:27:02 +0000
Subject: [PATCH] cuda: elide the GDN state gather only when its indices
 survive to the GDN

The fused state gather skips the GET_ROWS and lets the GDN kernel read the
cache rows through the gather's index tensor, but the allocator keeps that
tensor alive only up to the gather. On qwen35 the gate/beta nodes run
between the two and reuse its memory, so a single-token first ubatch
(llama-perplexity -ub 1, llama-bench -p 1) read garbage rows and aborted
with a memory aperture violation. Upstream has no elision and works.

Keep the elision only when no node from the gather to the GDN output
overlaps the indices. Qwen3.5-4B: -ub 1 perplexity runs and equals the
unfused result (PPL 7.6217); Flash-Next keeps the elision (tg32 48.34 vs
48.19 before, 47.29 with GGML_CUDA_NO_GDN_GATHER_FUSION=1).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DTjwwGh3znQpq4Yoxunx6b
---
 ggml/src/ggml-cuda/gated_delta_net.cu | 30 +++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/ggml/src/ggml-cuda/gated_delta_net.cu b/ggml/src/ggml-cuda/gated_delta_net.cu
index 8ff3b98ab..376c1db8a 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cu
+++ b/ggml/src/ggml-cuda/gated_delta_net.cu
@@ -564,6 +564,36 @@ bool ggml_cuda_gdn_state_gather_elidable(const ggml_cgraph * cgraph, const ggml_
     if (user == nullptr || ggml_nelements(user->src[5]) != ggml_nelements(gr)) {
         return false;
     }
+    // The GDN launch reads the gather's row indices, but the allocator keeps them alive only up to the
+    // gather itself: a node scheduled between the two, or the GDN output, may reuse their memory (the
+    // qwen35 graph computes gate/beta there; a single-token first ubatch then read garbage rows and
+    // faulted). Keep the elision only when nothing from the gather to the GDN overlaps the indices.
+    {
+        const ggml_tensor * ids = gr->src[1];
+        const char * i0 = (const char *) ids->data;
+        const char * i1 = i0 + ggml_nbytes(ids);
+        bool after_gr = false;
+        for (int i = 0; i < cgraph->n_nodes; i++) {
+            const ggml_tensor * n = cgraph->nodes[i];
+            if (n == gr) {
+                after_gr = true;
+                continue;
+            }
+            if (!after_gr) {
+                continue;
+            }
+            if (n->view_src == nullptr && n->data != nullptr) {
+                const char * a0 = (const char *) n->data;
+                const char * a1 = a0 + ggml_nbytes(n);
+                if (a0 < i1 && i0 < a1) {
+                    return false;
+                }
+            }
+            if (n == user) {
+                break;
+            }
+        }
+    }
     // The fused cache write-back stores sequence a's state into row kv_head + a in the same launch that
     // reads sequence b's state from row state_rows[b]. Fresh sequences all read the zero row rs_z, which
     // is one of their destination rows, so a prompt ubatch with several sequences read a state another
